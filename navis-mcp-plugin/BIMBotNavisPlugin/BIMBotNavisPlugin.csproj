<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BIM-Bot Navisworks Manage plugin — ADDITIVE-ONLY, Revit plugin untouched.
    One net48 build PER Navisworks year, 2020-2027 (see Directory.Build.props for why):
      dotnet build -c Release -p:NavisYear=<year>   ->  bin\N<year>\Release\net48\
    The API comes from the Speckle.Navisworks.API package for that year as compile-only
    references (never copied to output — Navisworks provides them at load time). TimeLiner
    is reached through reflection, so there is no Timeliner reference.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BIMBotNavisPlugin</RootNamespace>
    <AssemblyName>BIMBotNavisPlugin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Version>2.7.6</Version>
    <Authors>BIM-Bot</Authors>
    <Description>BIM-Bot Plugin for Autodesk Navisworks Manage - AI-powered coordination (parallel to Revit plugin)</Description>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 2026.0.0 ships the 2025 ComApi (v22) by mistake; 2026.0.1 has the right one (v23). -->
    <NavisApiPackageVersion>$(NavisYear).0.0</NavisApiPackageVersion>
    <NavisApiPackageVersion Condition="'$(NavisYear)' == '2026'">2026.0.1</NavisApiPackageVersion>
    <DefineConstants>$(DefineConstants);NAVIS$(NavisYear)</DefineConstants>
    <!-- Other years' obj\N<year> folders hold generated .cs files: keep them out of the compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- API-difference symbols used by Core/NavisCompat.cs (verified against each year's API DLLs). -->
  <PropertyGroup Condition="'$(NavisYear)' &lt;= '2020'">
    <DefineConstants>$(DefineConstants);NAVIS_NO_IMAGE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NavisYear)' &gt;= '2024'">
    <DefineConstants>$(DefineConstants);NAVIS_IMAGE_SECTIONING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NavisYear)' &gt;= '2026'">
    <DefineConstants>$(DefineConstants);NAVIS_ASSIGNEE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NavisYear)' &gt;= '2027'">
    <DefineConstants>$(DefineConstants);NAVIS_COMMENT_ASSIGNEE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only Navisworks API for $(NavisYear): Api, Clash, ComApi, Interop.ComApi, Controls. -->
    <PackageReference Include="Speckle.Navisworks.API" Version="$(NavisApiPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
