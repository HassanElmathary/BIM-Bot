<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One build per Revit version ("band"). Pass -p:RevitVersion=<year>; the band
    selects the TFM, the Revit API package, the compat #if symbols, and its own
    output folder. Defaults to 2026 so a bare `dotnet build` still does something
    sensible. Build every band with installer\build-plugin-bands.ps1.

    Why per-version rather than one net48 binary for 2020-2024: no single
    ElementId member spans the range. IntegerValue/(int) exists 2020-2025 and is
    gone in 2026; Value/(long) only arrives in 2024. ForgeTypeId does not exist
    at all in 2020. See Core\Compat\RevitCompat.cs.
  -->
  <!-- RevitVersion and the per-band output paths are set in Directory.Build.props,
       which is imported before the SDK props (required — see the note there). -->
  <PropertyGroup>
    <!-- Revit 2020 runs .NET Framework 4.7; 2021-2024 run 4.8; 2025-2026 .NET 8; 2027 .NET 10. -->
    <TargetFramework Condition="'$(RevitVersion)' == '2020'">net47</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2021'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2022'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2023'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Belt and braces: never sweep build output back into the compile. -->
  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
    <EmbeddedResource Remove="bin\**;obj\**" />
    <None Remove="bin\**;obj\**" />
  </ItemGroup>

  <!--
    This repo lives inside a OneDrive folder, which silently drops sync-conflict
    copies next to the original: "Application-<MachineOrUser>.cs", "… (1).cs",
    "… - Copy.cs". SDK-style projects glob every .cs file, so one such copy turns
    every type in it into a duplicate-definition error and the whole plugin stops
    building — with an error message that says nothing about OneDrive. They are
    never source; exclude them by shape.
  -->
  <ItemGroup>
    <Compile Remove="**\*-HassanElmthary.cs" />
    <Compile Remove="**\* - Copy.cs" />
    <Compile Remove="**\* - Copy (*).cs" />
    <Compile Remove="**\* (1).cs;**\* (2).cs;**\* (3).cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- REVIT2020..REVIT2027 plus two convenience bands used by the compat layer. -->
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(RevitVersion).0', '2024.0'))">$(DefineConstants);REVIT_PRE_2024</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(RevitVersion).0', '2022.0'))">$(DefineConstants);REVIT_PRE_2022</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionLessThan('$(RevitVersion).0', '2021.0'))">$(DefineConstants);REVIT_PRE_2021</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>BIMBotPlugin</RootNamespace>
    <AssemblyName>BIMBotPlugin</AssemblyName>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>2.3.1</Version>
    <Authors>BIM-Bot</Authors>
    <Description>BIM-Bot Plugin for Autodesk Revit - enables AI-powered interactions</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API from NuGet so the build works on machines without that
         Revit version installed. ExcludeAssets=runtime keeps RevitAPI.dll
         out of the output — Revit provides it at load time. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Framework references needed only on .NET Framework (implicit on net8/net10) -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <!-- Conditional Roslyn versions to safely prevent MissingMethodExceptions in Revit 2020-2024 -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Remove="Resources\Icons\*.png" />
    <EmbeddedResource Include="Resources\Icons\*.png" />
    <!-- Power BI export: .pbit template parts + the BIM-Bot 3D Viewer custom visual -->
    <EmbeddedResource Include="PowerBI\Templates\*.json" />
    <EmbeddedResource Include="PowerBI\Assets\*.pbiviz" />
  </ItemGroup>
</Project>
